---
import Icon from './Icon.astro';
import LinkButton from './LinkButton.astro';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__band" aria-hidden="true">
    <span class="hero__blob hero__blob--a"></span>
    <span class="hero__blob hero__blob--b"></span>
    <span class="hero__blob hero__blob--c"></span>
  </div>

  <div class="hero__content container">
    <h1 class="hero__title" id="hero-title">I'm Anthony.</h1>
    <p class="hero__lead">
      I build Discord bots for communities that take themselves seriously: moderation that keeps receipts, leveling
      people actually care about, dashboards that don't fight you.
    </p>
    <div class="actions">
      <LinkButton href="#insko">Meet Insko Bot</LinkButton>
      <a class="text-link" href="https://inskobot.me/#request-access" rel="noopener">
        Request access <Icon name="chevron-right" size={18} />
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    /* The band fills the top of the hero; the headline sits across its slanted lower edge. */
    --band: clamp(17rem, 50vh, 30rem);
    --title: clamp(3.25rem, 10vw, 6rem);
    --slant: 7deg;

    position: relative;
    padding-top: calc(var(--band) - 6.14vw - 0.55 * var(--title));
    padding-bottom: var(--s12);
    overflow: hidden;
    isolation: isolate;
  }

  @media (max-width: 36rem) {
    .hero {
      --band: clamp(12rem, 32vh, 18rem);
    }
  }

  /* A Stripe-style slanted gradient band. The blobs drift on the compositor (transform only). */
  .hero__band {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: var(--band);
    overflow: hidden;
    background: #ffb86b;
    transform: skewY(calc(var(--slant) * -1));
    transform-origin: 0 0;
  }

  .hero__blob {
    position: absolute;
    width: 70vmax;
    height: 70vmax;
    border-radius: 50%;
    will-change: transform;
  }

  .hero__blob--a {
    top: -40vmax;
    left: -18vmax;
    background: radial-gradient(closest-side, #ff8000, rgb(255 128 0 / 0));
  }

  .hero__blob--b {
    top: -25vmax;
    right: -25vmax;
    background: radial-gradient(closest-side, #ff5a36, rgb(255 90 54 / 0));
  }

  .hero__blob--c {
    bottom: -52vmax;
    left: 25%;
    background: radial-gradient(closest-side, #ffd9ae, rgb(255 217 174 / 0));
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__blob--a {
      animation: drift-a 22s ease-in-out infinite alternate;
    }

    .hero__blob--b {
      animation: drift-b 26s ease-in-out infinite alternate;
    }

    .hero__blob--c {
      animation: drift-c 30s ease-in-out infinite alternate;
    }

    .hero__content > * {
      animation: rise 1100ms var(--ease-out) backwards;
    }

    .hero__content > :nth-child(2) {
      animation-delay: 120ms;
    }

    .hero__content > :nth-child(3) {
      animation-delay: 240ms;
    }
  }

  @keyframes drift-a {
    to {
      transform: translate(22vmax, 8vmax) scale(1.15);
    }
  }

  @keyframes drift-b {
    to {
      transform: translate(-26vmax, 6vmax) scale(0.9);
    }
  }

  @keyframes drift-c {
    to {
      transform: translate(-20vmax, -6vmax) scale(1.2);
    }
  }

  /* As you scroll past, the hero eases up and dims, handing over to the next section. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero__content {
        animation-name: hero-out;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit 10% exit 95%;
      }
    }
  }

  @keyframes hero-out {
    to {
      opacity: 0.1;
      translate: 0 -3rem;
      scale: 0.96;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 1.25rem;
    }
  }

  .hero__content {
    display: grid;
    justify-items: center;
    gap: var(--s3);
    text-align: center;
  }

  .hero__title {
    font-size: var(--title);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .hero__lead {
    max-width: 38ch;
    font-size: clamp(1.1875rem, 2.1vw, 1.625rem);
    font-weight: 500;
    line-height: 1.38;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .hero__content .actions {
    margin-top: var(--s1);
  }
</style>
