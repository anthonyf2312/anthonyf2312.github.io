---
// Patchr's mark from the brand kit, with the stem and bars tagged so they can be animated.
import mark from '../assets/patchr/mark.svg?raw';

interface Props {
  class?: string;
  /** Leave out when the mark sits next to the word "Patchr". */
  label?: string;
}

const { class: className, label } = Astro.props;

const svg = mark
  .replace(/<title>.*?<\/title>/, '')
  .replace(' role="img"', '')
  .replace('<rect x="48"', '<rect class="mark__stem" x="48"')
  .replace('<rect x="76" y="40"', '<rect class="mark__bar mark__bar--1" x="76" y="40"')
  .replace('<rect x="76" y="64"', '<rect class="mark__bar mark__bar--2" x="76" y="64"')
  .replace('<rect x="76" y="88"', '<rect class="mark__bar mark__bar--3" x="76" y="88"');
---

<span
  class:list={['patchr-mark', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={svg}
/>
