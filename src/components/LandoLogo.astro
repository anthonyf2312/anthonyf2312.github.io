  ></path>
  <path
    class="ln__part ln__4"
    fill="currentColor"
    transform="translate(-289.43 -86.37)"
    d="M767.79,273.48c15.21,0,28.51,9.39,24,27.18L698.21,688.38a2.84,2.84,0,0,0,.75,2.67L780.4,772.4a2.83,2.83,0,0,0,4.76-1.34L908.75,257.94c10.86-45.4-19.49-88.66-69.8-88.66L612,169a2.83,2.83,0,0,0-2.75,2.17L584.52,273.61l-49.32,205a2.83,2.83,0,0,0,2.76,3.5h100.9a2.84,2.84,0,0,0,2.76-2.17l49.22-204.21a2.83,2.83,0,0,1,2.75-2.17Z"
