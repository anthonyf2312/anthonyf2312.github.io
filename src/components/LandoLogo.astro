---
// Lando Norris's LN4 logo, supplied by the site owner. It's Lando Norris's mark, shown on a fan page.
// Two pieces that interlock: the L (left) and the 4 (right). The page animates them separately.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

