---
// Lucide icons (ISC licence), inlined so the page ships no icon font or sprite request.
interface Props {
  name: 'lock' | 'chevron-right' | 'external';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'lock' && (
      <>
        <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
      </>
    )
  }
  {name === 'chevron-right' && <path d="m9 18 6-6-6-6" />}
  {
    name === 'external' && (
      <>
        <path d="M15 3h6v6" />
        <path d="M10 14 21 3" />
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
      </>
    )
  }
</svg>
