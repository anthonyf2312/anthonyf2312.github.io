---

<section class="ms" id="ms" aria-labelledby="ms-title">
  <div class="ms__aura" aria-hidden="true"></div>
  <div class="container ms__inner">
    <h2 class="ms__title" id="ms-title" data-reveal="lines">I also have MS.</h2>
