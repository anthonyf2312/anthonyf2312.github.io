---
// Add to Discord: the public Patchr invite. It leaves the site, so it opens in a new tab.
// tone="ink" is for the pink band, where a pink pill would vanish.
import PatchrIcon from './PatchrIcon.astro';
import { invite } from '../../data/patchr/links';

interface Props {
  small?: boolean;
  tone?: 'pink' | 'ink';
  class?: string;
}

const { small = false, tone = 'pink', class: className } = Astro.props;
---

<a
  class:list={['btn', tone === 'ink' ? 'btn--ink' : 'btn--pink', small && 'btn--sm', className]}
  href={invite}
  target="_blank"
  rel="noopener"
>
  <PatchrIcon name="discord" size={small ? 16 : 20} />
  <span class="invite-label">Add<span class="invite-label-rest"> to Discord</span></span>
  <span class="visually-hidden">(opens in a new tab)</span>
</a>
