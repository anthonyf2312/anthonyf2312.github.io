---
// Patchr's logo: the mark plus the wordmark set live in Inter ExtraBold, as the brand kit specifies,
// so it takes the text colour in both themes.
import PatchrMark from '../PatchrMark.astro';
---

<span class="wordmark">
  <PatchrMark class="wordmark__mark" />
  <span class="wordmark__text">patchr</span>
</span>
