---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found" description="This page doesn't exist." path="/404">
  <Nav />
  <main class="lost container">
    <h1 class="lost__title">Nothing here.</h1>
    <p class="lead lost__text">This page has moved, or it never existed.</p>
    <a class="text-link" href="/">Back to the home page <Icon name="chevron-right" size={18} /></a>
  </main>
</Base>

<style>
  .lost {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--s3);
    min-height: calc(100dvh - 3rem);
    padding-block: var(--s12);
    text-align: center;
  }

  .lost__title {
    font-size: clamp(3rem, 9vw, 5.5rem);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .lost__text {
    color: var(--ink-2);
  }
</style>
