---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import LinkButton from '../components/LinkButton.astro';
import SochiTrace from '../components/SochiTrace.astro';
import Swatch from '../components/Swatch.astro';
import Waves from '../components/Waves.astro';
import Icon from '../components/Icon.astro';
import { lapsLed, totalLaps } from '../data/sochi';
import inskoAvatar from '../assets/insko-avatar.png';
import speedmark from '../assets/speedmark.png';
import landoPhoto from '../assets/pixabay/lando-silverstone.jpg';
import rainPhoto from '../assets/pixabay/rain.jpg';
import credits from '../assets/pixabay/credits.json';

const credit = Object.fromEntries(credits.map((c) => [c.slot, c]));

const soon = [
  { title: 'A public bot', text: 'For any server, not just Insko.' },
  { title: 'Discord server', text: 'Opens when the public bot does.' },
  { title: 'GitHub', text: 'The public bot’s code, in the open.' },
];
---

<Base
  title="Anthony: Discord bots, Formula 1, and MS"
  description="I build Discord bots for communities that take themselves seriously. Weekends are for Formula 1. And I have relapsing-remitting MS."
>
  <a class="skip" href="#main">Skip to content</a>
  <Nav />

  <main id="main">
    <Hero />

    <section class="about" aria-label="About">
      <div class="container">
        <Statement
          text="Weekends are for Formula 1. And I have relapsing-remitting MS, which you’ll hear from me before you hear it about me."
        />
      </div>
    </section>

    <!-- Insko Bot -->
    <section class="dark insko" id="insko" aria-labelledby="insko-title">
      <div class="container insko__inner">
        <Image
          class="insko__icon"
          src={inskoAvatar}
          alt="Insko Bot's icon: a violet monogram on black."
          width={120}
          height={120}
          densities={[1, 2]}
        />
        <h2 class="headline" id="insko-title">Insko Bot.</h2>
        <p class="lead insko__lead">
          Built for the Insko community. Private, self-hosted, and open to other servers that ask.
        </p>
        <div class="actions">
          <LinkButton href="https://inskobot.me/#request-access" external>Request access</LinkButton>
          <a class="text-link" href="https://github.com/anthonyf2312/InskoBot" rel="noopener">
            View on GitHub <Icon name="chevron-right" size={18} />
          </a>
        </div>
        <p class="insko__next">A public bot is next. <a href="#soon">See what’s coming</a>.</p>
      </div>
    </section>

    <!-- Formula 1 -->
    <section class="dark f1" id="f1" aria-labelledby="f1-title">
      <div class="container f1__intro">
        <h2 class="headline" id="f1-title">Papaya, since Sochi.</h2>
        <p class="lead f1__lead">Formula 1 is my weekend. McLaren, and Lando Norris in particular.</p>
      </div>

      <figure class="f1__photo">
        <div class="f1__frame">
          <Picture
            src={landoPhoto}
            formats={['avif', 'webp']}
            widths={[640, 960, 1280]}
            sizes="(max-width: 1180px) 100vw, 1180px"
            alt="Lando Norris's papaya and blue McLaren on track at Silverstone."
          />
        </div>
        <figcaption class="container f1__caption">
          Silverstone, 2019. Photo by <a href={credit['lando-silverstone'].pageURL}>{credit['lando-silverstone'].user}</a>{' '}
          on Pixabay.
        </figcaption>
      </figure>

      <div class="container f1__pick">
        <p class="lead">
          I picked my driver at Sochi in 2021. His first pole, and he led {lapsLed} of the {totalLaps} laps.
        </p>
      </div>

      <SochiTrace />
    </section>

    <!-- The rain -->
    <section class="rain" aria-labelledby="rain-title">
      <Picture
        class="rain__photo"
        src={rainPhoto}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280]}
        sizes="100vw"
        alt=""
      />
      <div class="container rain__text">
        <h2 class="headline" id="rain-title">Then the rain came.</h2>
        <p class="lead">
          With a few laps left he stayed out on slicks, went off at turn 5, and his first win went with it. He finished
          seventh. That was the day I started supporting him.
        </p>
      </div>
      <p class="rain__credit fine">
        Photo by <a href={credit.rain.pageURL}>{credit.rain.user}</a> on Pixabay.
      </p>
    </section>

    <section class="worst" aria-label="Why Lando">
      <div class="container worst__inner">
        <blockquote class="worst__quote">
          <p>Backing someone on their worst day beats joining on their best.</p>
        </blockquote>
        <p class="worst__sign">
          <Image src={speedmark} alt="McLaren speedmark" width={36} height={36} densities={[1, 2]} />
          <span>Lando Norris, car 4. Since Russia, 2021.</span>
        </p>
      </div>
    </section>

    <Swatch />

    <!-- MS -->
    <section class="ms" id="ms" aria-labelledby="ms-title">
      <div class="container ms__inner">
        <h2 class="headline" id="ms-title">And yes, I have MS.</h2>
        <p class="lead ms__lead">Relapsing-remitting multiple sclerosis. Not a secret, not a tragedy, not the whole story.</p>
        <Waves />
        <p class="lead ms__lead">It comes in waves: a relapse, then remission. It changes my pace, not my direction.</p>
        <p class="body ms__keep">If you’ve just been diagnosed and you’re reading this: keep building.</p>
        <a
          class="text-link"
          href="https://www.mssociety.org.uk/about-ms/types-of-ms/relapsing-remitting-ms"
          rel="noopener"
        >
          What is RRMS? <Icon name="external" size={16} />
        </a>
      </div>
    </section>

    <!-- Coming soon -->
    <section class="grey soon" id="soon" aria-labelledby="soon-title">
      <div class="container">
        <div class="soon__head">
          <h2 class="headline" id="soon-title">Coming soon.</h2>
          <p class="lead soon__lead">
            A public bot is on the way. It gets its own Discord server when it launches, and its code goes on GitHub.
          </p>
        </div>
        <ul class="soon__list">
          {
            soon.map((item) => (
              <li class="soon__item">
                <p class="soon__name">{item.title}</p>
                <p class="soon__text">{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <footer class="grey footer">
    <div class="container footer__inner">
      <p class="fine">
        Photos from Pixabay by <a href={credit['lando-silverstone'].userURL}>{credit['lando-silverstone'].user}</a>{' '}
        and <a href={credit.rain.userURL}>{credit.rain.user}</a>. McLaren speedmark by{' '}
        <a href="https://icons8.com">icons8</a>. Lap positions from the <a href="https://api.jolpi.ca/">Jolpica F1 API</a>.
      </p>
      <p class="fine">© 2026 Anthony.</p>
    </div>
  </footer>
</Base>

<style>
  /* About statement */
  .about {
    padding-block: var(--section-y);
  }

  /* Insko Bot */
  .insko {
    padding-block: var(--section-y);
  }

  .insko__inner {
    display: grid;
    justify-items: center;
    gap: var(--s3);
    text-align: center;
  }

  .insko :global(.insko__icon) {
    width: 7.5rem;
    height: 7.5rem;
    margin-bottom: var(--s2);
    border-radius: 27%;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.14);
  }

  .insko__lead {
    max-width: 30ch;
    color: var(--on-dark-2);
  }

  .insko .actions {
    margin-top: var(--s2);
  }

  .insko__next {
    margin-top: var(--s6);
    color: var(--on-dark-2);
    font-size: 0.9375rem;
  }

  .insko__next a {
    color: var(--on-dark);
  }

  /* Formula 1 */
  .f1 {
    padding-top: var(--s8);
  }

  .f1__intro {
    display: grid;
    justify-items: center;
    gap: var(--s3);
    text-align: center;
  }

  .f1__lead {
    max-width: 28ch;
    color: var(--on-dark-2);
  }

  .f1__photo {
    margin-top: var(--s12);
  }

  .f1__frame {
    width: min(100% - 2 * var(--gutter), 1180px);
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .f1__frame :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1280 / 735;
    object-fit: cover;
  }

  .f1__caption {
    margin-top: var(--s2);
    color: #86868b;
    font-size: 0.8125rem;
    text-align: center;
  }

  .f1__caption a,
  .rain__credit a,
  .footer a {
    color: inherit;
  }

  .f1__pick {
    padding-top: var(--s16);
    text-align: center;
  }

  .f1__pick .lead {
    max-width: 30ch;
    margin-inline: auto;
  }

  /* The photo grows to full width as it scrolls in, the way Apple opens a product shot. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .f1__frame {
        animation-name: open;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% cover 45%;
      }
    }
  }

  @keyframes open {
    from {
      scale: 0.8;
      border-radius: 44px;
    }
  }

  /* The rain */
  .rain {
    position: relative;
    display: grid;
    align-items: center;
    min-height: clamp(30rem, 90vh, 52rem);
    overflow: hidden;
    isolation: isolate;
    background: #d9dcdc;
  }

  .rain :global(.rain__photo),
  .rain :global(.rain__photo img) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rain::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(rgb(255 255 255 / 0.15), rgb(255 255 255 / 0.55));
  }

  .rain__text {
    display: grid;
    justify-items: center;
    gap: var(--s3);
    text-align: center;
  }

  .rain__text .lead {
    max-width: 32ch;
  }

  .rain__credit {
    position: absolute;
    right: var(--gutter);
    bottom: var(--s2);
    color: var(--ink);
  }

  /* Worst day */
  .worst {
    padding-block: var(--section-y);
  }

  .worst__inner {
    display: grid;
    justify-items: center;
    gap: var(--s3);
    text-align: center;
  }

  .worst__quote p {
    max-width: 18ch;
    font-size: clamp(2.25rem, 5.4vw, 4rem);
    font-weight: 650;
    line-height: 1.06;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .worst__sign {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: var(--s3);
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  /* MS */
  .ms {
    padding-block: var(--section-y);
  }

  .ms__inner {
    display: grid;
    justify-items: center;
    gap: var(--s3);
    text-align: center;
  }

  .ms__lead {
    max-width: 32ch;
    color: var(--ink-2);
  }

  .ms__keep {
    margin-top: var(--s4);
    font-weight: 560;
  }

  .ms .text-link {
    margin-top: calc(var(--s1) * -1);
  }

  /* Coming soon */
  .soon {
    padding-block: var(--section-y) var(--s16);
  }

  .soon__head {
    display: grid;
    justify-items: center;
    gap: var(--s3);
    text-align: center;
  }

  .soon__lead {
    max-width: 34ch;
    color: var(--ink-2);
  }

  .soon__list {
    max-width: 48rem;
    margin: var(--s12) auto 0;
    border-top: 1px solid var(--hair);
  }

  .soon__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    align-items: baseline;
    gap: var(--s1) var(--s4);
    padding-block: var(--s3);
    border-bottom: 1px solid var(--hair);
  }

  .soon__name {
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    font-weight: 650;
    letter-spacing: -0.025em;
  }

  .soon__text {
    color: var(--ink-2);
    font-size: 1.0625rem;
  }

  @media (max-width: 36rem) {
    .soon__item {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Footer */
  .footer {
    border-top: 1px solid var(--hair);
  }

  .footer__inner {
    display: grid;
    gap: var(--s1);
    padding-block: var(--s4) var(--s6);
  }

  .footer .fine {
    max-width: 80ch;
  }
</style>
