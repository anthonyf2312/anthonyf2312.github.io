---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import LinkButton from '../components/LinkButton.astro';
import SochiTrace from '../components/SochiTrace.astro';
import Swatch from '../components/Swatch.astro';
import Waves from '../components/Waves.astro';
import Icon from '../components/Icon.astro';
import LandoLogo from '../components/LandoLogo.astro';
import McLarenWordmark from '../components/McLarenWordmark.astro';
import Speedmark from '../components/Speedmark.astro';
import PatchrMark from '../components/PatchrMark.astro';
import { lapsLed, totalLaps } from '../data/sochi';
import inskoAvatar from '../assets/insko-avatar.png';
import rainPhoto from '../assets/pixabay/rain.jpg';
import credits from '../assets/pixabay/credits.json';

const credit = Object.fromEntries(credits.map((c) => [c.slot, c]));

const patchr = [
  { title: 'GitHub releases', text: 'Posted to your channel within minutes of going out.' },
  { title: 'Your own notes', text: 'For projects that don’t live on GitHub. Write, preview, post.' },
  { title: 'Support server', text: 'Questions, bug reports, and Patchr’s own patch notes.' },
  { title: 'Source code', text: 'Open source on GitHub, MIT licensed.' },
];
---

<Base
  title="Anthony: Discord bots, Formula 1, and MS"
  description="I build Discord bots for communities that take themselves seriously. Weekends are for Formula 1. And I have relapsing-remitting MS."
>
  <a class="skip" href="#main">Skip to content</a>
  <Nav />

  <main id="main">
    <Hero />

    <section class="about" aria-label="About">
      <div class="container">
        <Statement
          text="Weekends are for Formula 1. And I have relapsing-remitting MS, which you’ll hear from me before you hear it about me."
        />
      </div>
    </section>

    <!-- Insko Bot -->
    <section class="dark insko" id="insko" aria-labelledby="insko-title">
      <div class="container insko__grid">
        <div class="insko__text" data-reveal-group>
          <h2 class="headline" id="insko-title" data-reveal>Insko Bot.</h2>
          <p class="lead insko__lead" data-reveal>
            Built for the Insko community. Private, self-hosted, and open to other servers that ask.
          </p>
          <div class="actions" data-reveal>
            <LinkButton href="https://inskobot.me/#request-access" external>Request access</LinkButton>
            <a class="text-link" href="https://github.com/anthonyf2312/InskoBot" target="_blank" rel="noopener">
              View on GitHub <Icon name="external" size={16} /><span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </div>
          <p class="insko__next" data-reveal>Out now: Patchr, a bot for any server. <a href="/patchr/">Meet Patchr</a>.</p>
        </div>
        <!-- The icon crosses the edge between the white statement and the black section. -->
        <div class="insko__icon-wrap" data-reveal="pop">
          <Image
            class="insko__icon"
            src={inskoAvatar}
            alt="Insko Bot's icon: a violet monogram on black."
            width={288}
            height={288}
            densities={[1, 2]}
          />
        </div>
      </div>
    </section>

    <!-- Formula 1 -->
    <section class="dark f1" id="f1" aria-labelledby="f1-title">
      <div class="f1__stage">
        <div class="f1__head" data-reveal-group>
          <h2 class="headline" id="f1-title" data-reveal>Papaya, since Sochi.</h2>
          <p class="lead f1__lead" data-reveal>Formula 1 is my weekend. McLaren, and Lando Norris in particular.</p>
        </div>

        <!-- A dark tile that runs off the right edge. It wipes in, then the two halves of Lando's LN4 logo slide together. -->
        <figure class="f1__photo">
          <div class="f1__card" data-reveal="panel">
            <McLarenWordmark class="f1__wordmark" />
            <LandoLogo class="f1__ln" />
            <p class="f1__driver">Lando Norris</p>
          </div>
          <figcaption class="f1__caption">The LN4 logo belongs to Lando Norris. McLaren marks belong to McLaren.</figcaption>
        </figure>

        <p class="lead f1__pick" data-reveal>
          I picked my driver at Sochi in 2021. His first pole, and he led {lapsLed} of the {totalLaps} laps.
        </p>
      </div>

      <SochiTrace />
    </section>

    <!-- The rain: a tall panel off the left edge, drifting down as you scroll. -->
    <section class="grey rain" aria-labelledby="rain-title">
      <div class="rain__stage">
        <div class="rain__panel" data-reveal="wipe-left">
          <Picture
            src={rainPhoto}
            formats={['avif', 'webp']}
            widths={[640, 960, 1280]}
            sizes="(max-width: 48rem) 100vw, 50vw"
            alt="Raindrops on a window against a pale grey sky."
          />
        </div>
        <div class="rain__text" data-reveal-group>
          <h2 class="headline" id="rain-title" data-reveal>Then the rain came.</h2>
          <p class="lead" data-reveal>
            With a few laps left he stayed out on slicks, went off at turn 5, and his first win went with it. He
            finished seventh. That was the day I started supporting him.
          </p>
          <p class="fine" data-reveal>
            Photo by <a href={credit.rain.pageURL} target="_blank" rel="noopener">{credit.rain.user}</a> on Pixabay.
          </p>
        </div>
      </div>
    </section>

    <section class="worst" aria-label="Why Lando">
      <div class="container worst__grid" data-reveal-group>
        <blockquote class="worst__quote" data-reveal>
          <p>Backing someone on their worst day beats joining on their best.</p>
        </blockquote>
        <div class="worst__mark" data-reveal="sweep">
          <Speedmark />
        </div>
        <p class="worst__sign" data-reveal>Lando Norris, car 4. Since Russia, 2021.</p>
      </div>
    </section>

    <Swatch />

    <!-- MS -->
    <section class="ms" id="ms" aria-labelledby="ms-title">
      <div class="container ms__inner" data-reveal-group>
        <h2 class="headline" id="ms-title" data-reveal>And yes, I have MS.</h2>
        <p class="lead ms__lead" data-reveal>Relapsing-remitting multiple sclerosis. Not a secret, not a tragedy, not the whole story.</p>
        <Waves />
        <p class="lead ms__lead" data-reveal>It comes in waves: a relapse, then remission. It changes my pace, not my direction.</p>
        <p class="body ms__keep" data-reveal>If you’ve just been diagnosed and you’re reading this: keep building.</p>
        <a
          class="text-link"
          href="https://www.mssociety.org.uk/about-ms/types-of-ms/relapsing-remitting-ms"
          target="_blank"
          rel="noopener"
        >
          What is RRMS? <Icon name="external" size={16} /><span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      </div>
    </section>

    <!-- Patchr, out now. The mark sits centred and crosses up into the white MS section above. -->
    <section class="grey patchr" id="patchr" aria-labelledby="patchr-title">
      <div class="container patchr__inner" data-reveal-group>
        <div class="patchr__mark-wrap" data-reveal="pop">
          <PatchrMark class="patchr__mark" />
        </div>
        <h2 class="headline" id="patchr-title" data-reveal>Patchr.</h2>
        <p class="lead patchr__lead" data-reveal>
          Patch notes, posted beautifully. It’s my public bot, and version 1.0 is out now.
        </p>
        <div class="actions patchr__actions" data-reveal>
          <LinkButton href="/patchr/">Meet Patchr</LinkButton>
          <a class="text-link" href="https://github.com/anthonyf2312/patchr" target="_blank" rel="noopener">
            View code <Icon name="external" size={16} /><span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </div>
      </div>
      <div class="container">
        <ul class="patchr__list" data-reveal-group>
          {
            patchr.map((item) => (
              <li class="patchr__item" data-reveal>
                <p class="patchr__name">{item.title}</p>
                <p class="patchr__text">{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <footer class="grey footer">
    <div class="container footer__inner">
      <p class="fine">
        Rain photo from Pixabay by <a href={credit.rain.userURL} target="_blank" rel="noopener">{credit.rain.user}</a>.
        The LN4 logo is Lando Norris's, and the McLaren wordmark and speedmark are McLaren trademarks, shown on a fan
        page with no affiliation. Lap positions from the{' '}
        <a href="https://api.jolpi.ca/" target="_blank" rel="noopener">Jolpica F1 API</a>.
      </p>
      <p class="fine">© 2026 Anthony.</p>
    </div>
  </footer>
</Base>

<style>
  /* About statement */
  .about {
    padding-block: var(--section-y);
  }

  /* Insko Bot: copy on the left, the icon large on the right, crossing up into the white section above. */
  .insko {
    position: relative;
    padding-block: var(--section-y);
  }

  .insko__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: start;
    gap: var(--s8);
  }

  .insko__text {
    display: grid;
    justify-items: start;
    gap: var(--s3);
  }

  .insko__lead {
    max-width: 26ch;
    color: var(--on-dark-2);
  }

  .insko .actions {
    justify-content: flex-start;
    margin-top: var(--s1);
  }

  .insko__next {
    margin-top: var(--s4);
    color: var(--on-dark-2);
    font-size: 0.9375rem;
  }

  .insko__next a {
    color: var(--on-dark);
  }

  .insko__icon-wrap {
    --icon: clamp(11rem, 24vw, 18rem);
    position: relative;
    z-index: 1;
    justify-self: end;
    width: var(--icon);
    margin-top: calc(-1 * var(--section-y) - var(--icon) * 0.45);
  }

  .insko :global(.insko__icon) {
    width: 100%;
    height: auto;
    border-radius: 22.5%;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.14);
  }

  /* Formula 1: the copy holds the left column; the photo bleeds off the right edge of the screen. */
  .f1 {
    padding-top: var(--section-y);
    /* clip, not hidden: the drive-in may not widen the page, and the pinned trace inside must stay sticky. */
    overflow-x: clip;
  }

  .f1__stage {
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--gutter), 1fr)
      [text-start] minmax(0, 24rem)
      [text-end] var(--s8)
      [photo-start] minmax(0, calc(var(--container) - 24rem - var(--s8)))
      minmax(var(--gutter), 1fr) [full-end];
    grid-template-rows: auto 1fr auto;
  }

  .f1__head {
    grid-column: text;
    grid-row: 1;
    display: grid;
    gap: var(--s3);
  }

  .f1__lead {
    color: var(--on-dark-2);
  }

  .f1__photo {
    grid-column: photo-start / full-end;
    grid-row: 1 / 4;
    margin-top: var(--s12);
  }

  /* The team tile: wordmark top left, Lando's 4 large on the right, his name bottom left. */
  .f1__card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    aspect-ratio: 4 / 3;
    padding: clamp(1.5rem, 3.4vw, 3rem);
    overflow: hidden;
    border-radius: var(--radius) 0 0 var(--radius);
    background: #161617;
  }

  .f1__card :global(.f1__wordmark) {
    width: clamp(8rem, 15vw, 12rem);
    height: auto;
    color: var(--on-dark);
  }

  .f1__card :global(.f1__ln) {
    position: absolute;
    right: clamp(2.5rem, 13%, 10rem);
    bottom: 14%;
    height: 66%;
    width: auto;
    overflow: visible;
    color: var(--lando-volt);
  }

  .f1__driver {
    grid-row: 3;
    position: relative;
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    font-weight: 650;
    letter-spacing: -0.025em;
  }

  /*
    The focal moment. Once the tile has wiped in from the right, the two halves of the LN4 logo slide
    in along its slant from opposite corners (the L up from the bottom left, the 4 down from the top
    right) and lock together.
  */
  :global(.js) .f1__card :global(.ln__part) {
    transform-box: fill-box;
    opacity: 0;
    transition:
      opacity 500ms ease,
      translate 1100ms var(--ease-out);
    transition-delay: 500ms;
  }

  :global(.js) .f1__card :global(.ln__l) {
    translate: -7% 26%;
  }

  :global(.js) .f1__card :global(.ln__4) {
    translate: 7% -26%;
    transition-delay: 600ms;
  }

  :global(.js) .f1__card.is-in :global(.ln__part) {
    opacity: 1;
    translate: 0 0;
  }

  :global(.js) .f1__card :global(.f1__wordmark),
  :global(.js) .f1__card .f1__driver {
    opacity: 0;
    translate: 0 0.75rem;
    transition:
      opacity 600ms ease,
      translate 800ms var(--ease-out);
    transition-delay: 1150ms;
  }

  :global(.js) .f1__card.is-in :global(.f1__wordmark),
  :global(.js) .f1__card.is-in .f1__driver {
    opacity: 1;
    translate: 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .f1__card :global(.ln__part),
    :global(.js) .f1__card :global(.f1__wordmark),
    :global(.js) .f1__card .f1__driver {
      translate: 0 0;
      transition: opacity 400ms ease;
      transition-delay: 200ms;
    }
  }

  .f1__caption {
    margin-top: var(--s2);
    color: #86868b;
    font-size: 0.8125rem;
  }

  .f1__pick {
    grid-column: text;
    grid-row: 3;
    align-self: end;
    margin-bottom: var(--s6);
  }

  .f1__caption a,
  .rain a,
  .footer a {
    color: inherit;
  }


  /* The rain: a tall panel bleeding off the left edge, the copy on the right. */
  .rain {
    padding-block: var(--section-y);
    overflow: hidden;
  }

  .rain__stage {
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--gutter), 1fr)
      [panel-end-inner] minmax(0, calc(var(--container) - 26rem - var(--s8)))
      [panel-end] var(--s8)
      [text-start] minmax(0, 26rem)
      [text-end] minmax(var(--gutter), 1fr) [full-end];
    align-items: center;
  }

  .rain__panel {
    grid-column: full-start / panel-end;
    grid-row: 1;
    height: min(42rem, 78vh);
    overflow: hidden;
    border-radius: 0 var(--radius) var(--radius) 0;
    background: #d9dcdc;
  }

  .rain__panel :global(picture) {
    display: block;
    height: 100%;
  }

  .rain__panel :global(img) {
    width: 100%;
    height: 118%;
    object-fit: cover;
  }

  .rain__text {
    grid-column: text;
    grid-row: 1;
    display: grid;
    gap: var(--s3);
  }

  .rain__text .fine {
    margin-top: var(--s2);
  }

  /* The drops drift downward as you scroll, as if still falling. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .rain__panel :global(img) {
        animation-name: fall;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }
    }
  }

  @keyframes fall {
    from {
      translate: 0 -15%;
    }
    to {
      translate: 0 0;
    }
  }

  /* Worst day: the quote on the left, the speedmark sweeping in large on the right. */
  .worst {
    padding-block: var(--section-y);
    overflow: hidden;
  }

  .worst__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s2) var(--s8);
  }

  .worst__quote p {
    max-width: 16ch;
    font-size: clamp(2.25rem, 5.4vw, 4rem);
    font-weight: 650;
    line-height: 1.06;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .worst__mark {
    grid-column: 2;
    grid-row: 1 / 3;
    width: clamp(9rem, 20vw, 16rem);
    color: var(--papaya);
  }

  .worst__mark :global(svg) {
    width: 100%;
    height: auto;
  }

  .worst__sign {
    grid-column: 1;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  @media (max-width: 48rem) {
    .insko__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s4);
    }

    .insko__icon-wrap {
      --icon: 9rem;
      order: -1;
    }

    .f1__stage {
      grid-template-columns:
        [full-start] var(--gutter)
        [text-start photo-start] minmax(0, 1fr)
        [text-end] var(--gutter) [full-end];
      grid-template-rows: auto;
    }

    .f1__photo {
      grid-row: 2;
      margin-top: var(--s8);
    }

    .f1__pick {
      grid-row: 3;
      margin: var(--s8) 0 0;
    }

    .rain__stage {
      grid-template-columns:
        [full-start] var(--gutter)
        [text-start] minmax(0, 1fr)
        [panel-end text-end] var(--gutter) [full-end];
    }

    .rain__panel {
      grid-column: full-start / panel-end;
      height: auto;
      aspect-ratio: 4 / 3;
      margin-bottom: var(--s6);
    }

    .rain__text {
      grid-row: 2;
    }

    .worst__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .worst__mark {
      grid-column: 1;
      grid-row: auto;
      justify-self: end;
      order: -1;
      width: 7rem;
    }
  }

  /* MS */
  .ms {
    padding-block: var(--section-y);
  }

  .ms__inner {
    display: grid;
    justify-items: center;
    gap: var(--s3);
    text-align: center;
  }

  .ms__lead {
    max-width: 32ch;
    color: var(--ink-2);
  }

  .ms__keep {
    margin-top: var(--s4);
    font-weight: 560;
  }

  .ms .text-link {
    margin-top: calc(var(--s1) * -1);
  }

  /* Patchr: the page's resolution, a quiet centred stack. The mark crosses up into the MS section. */
  /* No top padding: the mark itself opens the section, straddling the edge with the white MS section. */
  .patchr {
    padding-block: 0 var(--s16);
  }

  .patchr__inner {
    display: grid;
    justify-items: center;
    gap: var(--s3);
    text-align: center;
  }

  .patchr__mark-wrap {
    --mark: clamp(6.5rem, 13vw, 9rem);
    position: relative;
    z-index: 1;
    width: var(--mark);
    /* Half the mark rises into the section above, so its centre sits exactly on the edge. */
    margin-top: calc(var(--mark) / -2);
    margin-bottom: var(--s4);
  }

  .patchr :global(.patchr__mark) {
    display: block;
    width: 100%;
    height: auto;
  }

  /*
    The authored moment: once the tile has popped in, its changelog lines write themselves. The stem
    drops, the white bars draw out, and the pink one (the newest change) arrives last.
  */
  :global(.js) .patchr__mark-wrap :global(.mark__stem),
  :global(.js) .patchr__mark-wrap :global(.mark__bar) {
    transform-box: fill-box;
    transition: scale 700ms var(--ease-out);
  }

  :global(.js) .patchr__mark-wrap :global(.mark__stem) {
    transform-origin: 50% 0;
    scale: 1 0;
    transition-delay: 250ms;
  }

  :global(.js) .patchr__mark-wrap :global(.mark__bar) {
    transform-origin: 0 50%;
    scale: 0 1;
    transition-delay: 450ms;
  }

  :global(.js) .patchr__mark-wrap :global(.mark__bar:last-of-type) {
    transition-delay: 560ms;
  }

  :global(.js) .patchr__mark-wrap :global(.mark__bar--new) {
    transition-duration: 950ms;
    transition-delay: 720ms;
  }

  :global(.js) .patchr__mark-wrap.is-in :global(.mark__stem),
  :global(.js) .patchr__mark-wrap.is-in :global(.mark__bar) {
    scale: 1 1;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .patchr__mark-wrap :global(.mark__stem),
    :global(.js) .patchr__mark-wrap :global(.mark__bar) {
      scale: 1 1;
      transition: none;
    }
  }

  .patchr__lead {
    max-width: 30ch;
    color: var(--ink-2);
  }

  .patchr__actions {
    margin-top: var(--s1);
  }

  .patchr__list {
    max-width: 48rem;
    margin: var(--s12) auto 0;
    border-top: 1px solid var(--hair);
  }

  .patchr__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    align-items: baseline;
    gap: var(--s1) var(--s4);
    padding-block: var(--s3);
    border-bottom: 1px solid var(--hair);
  }

  .patchr__name {
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    font-weight: 650;
    letter-spacing: -0.025em;
  }

  .patchr__text {
    color: var(--ink-2);
    font-size: 1.0625rem;
  }

  @media (max-width: 36rem) {
    .patchr__item {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Footer */
  .footer {
    border-top: 1px solid var(--hair);
  }

  .footer__inner {
    display: grid;
    gap: var(--s1);
    padding-block: var(--s4) var(--s6);
  }

  .footer .fine {
    max-width: 80ch;
  }
</style>
