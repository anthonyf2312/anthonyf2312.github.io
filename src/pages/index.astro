---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import LinkButton from '../components/LinkButton.astro';
import SochiTrace from '../components/SochiTrace.astro';
import Swatch from '../components/Swatch.astro';
import Waves from '../components/Waves.astro';
import Icon from '../components/Icon.astro';
import { lapsLed, totalLaps } from '../data/sochi';
import inskoAvatar from '../assets/insko-avatar.png';
import speedmark from '../assets/speedmark.png';
import landoPhoto from '../assets/pixabay/lando-silverstone.jpg';
import rainPhoto from '../assets/pixabay/rain.jpg';
import credits from '../assets/pixabay/credits.json';

const credit = Object.fromEntries(credits.map((c) => [c.slot, c]));

const soon = [
  { title: 'A public bot', text: 'For any server, not just Insko.' },
  { title: 'Discord server', text: 'Opens when the public bot does.' },
  { title: 'GitHub', text: 'The public bot’s code, in the open.' },
];
---

<Base
  title="Anthony: Discord bots, Formula 1, and MS"
  description="I build Discord bots for communities that take themselves seriously. Weekends are for Formula 1. And I have relapsing-remitting MS."
>
  <a class="skip" href="#main">Skip to content</a>
  <Nav />

  <main id="main">
    <Hero />

    <section class="about" aria-label="About">
      <div class="container">
        <Statement
          text="Weekends are for Formula 1. And I have relapsing-remitting MS, which you’ll hear from me before you hear it about me."
        />
      </div>
    </section>

    <!-- Insko Bot -->
    <section class="dark insko" id="insko" aria-labelledby="insko-title">
      <div class="container insko__grid">
        <div class="insko__text">
          <h2 class="headline" id="insko-title">Insko Bot.</h2>
          <p class="lead insko__lead">
            Built for the Insko community. Private, self-hosted, and open to other servers that ask.
          </p>
          <div class="actions">
            <LinkButton href="https://inskobot.me/#request-access" external>Request access</LinkButton>
            <a class="text-link" href="https://github.com/anthonyf2312/InskoBot" rel="noopener">
              View on GitHub <Icon name="chevron-right" size={18} />
            </a>
          </div>
          <p class="insko__next">A public bot is next. <a href="#soon">See what’s coming</a>.</p>
        </div>
        <!-- The icon crosses the edge between the white statement and the black section. -->
        <Image
          class="insko__icon"
          src={inskoAvatar}
          alt="Insko Bot's icon: a violet monogram on black."
          width={288}
          height={288}
          densities={[1, 2]}
        />
      </div>
    </section>

    <!-- Formula 1 -->
    <section class="dark f1" id="f1" aria-labelledby="f1-title">
      <div class="f1__stage">
        <div class="f1__head">
          <h2 class="headline" id="f1-title">Papaya, since Sochi.</h2>
          <p class="lead f1__lead">Formula 1 is my weekend. McLaren, and Lando Norris in particular.</p>
        </div>

        <!-- The car drives in from the right and runs off the edge of the screen. -->
        <figure class="f1__photo">
          <div class="f1__frame">
            <Picture
              src={landoPhoto}
              formats={['avif', 'webp']}
              widths={[640, 960, 1280]}
              sizes="(max-width: 48rem) 100vw, 60vw"
              alt="Lando Norris's papaya and blue McLaren on track at Silverstone."
            />
          </div>
          <figcaption class="f1__caption">
            Silverstone, 2019. Photo by <a href={credit['lando-silverstone'].pageURL}>{credit['lando-silverstone'].user}</a>{' '}
            on Pixabay.
          </figcaption>
        </figure>

        <p class="lead f1__pick">
          I picked my driver at Sochi in 2021. His first pole, and he led {lapsLed} of the {totalLaps} laps.
        </p>
      </div>

      <SochiTrace />
    </section>

    <!-- The rain: a tall panel off the left edge, drifting down as you scroll. -->
    <section class="grey rain" aria-labelledby="rain-title">
      <div class="rain__stage">
        <div class="rain__panel">
          <Picture
            src={rainPhoto}
            formats={['avif', 'webp']}
            widths={[640, 960, 1280]}
            sizes="(max-width: 48rem) 100vw, 50vw"
            alt="Raindrops on a window against a pale grey sky."
          />
        </div>
        <div class="rain__text">
          <h2 class="headline" id="rain-title">Then the rain came.</h2>
          <p class="lead">
            With a few laps left he stayed out on slicks, went off at turn 5, and his first win went with it. He
            finished seventh. That was the day I started supporting him.
          </p>
          <p class="fine">Photo by <a href={credit.rain.pageURL}>{credit.rain.user}</a> on Pixabay.</p>
        </div>
      </div>
    </section>

    <section class="worst" aria-label="Why Lando">
      <div class="container worst__grid">
        <blockquote class="worst__quote">
          <p>Backing someone on their worst day beats joining on their best.</p>
        </blockquote>
        <Image
          class="worst__mark"
          src={speedmark}
          alt="McLaren speedmark"
          width={224}
          height={224}
          densities={[1, 2]}
        />
        <p class="worst__sign">Lando Norris, car 4. Since Russia, 2021.</p>
      </div>
    </section>

    <Swatch />

    <!-- MS -->
    <section class="ms" id="ms" aria-labelledby="ms-title">
      <div class="container ms__inner">
        <h2 class="headline" id="ms-title">And yes, I have MS.</h2>
        <p class="lead ms__lead">Relapsing-remitting multiple sclerosis. Not a secret, not a tragedy, not the whole story.</p>
        <Waves />
        <p class="lead ms__lead">It comes in waves: a relapse, then remission. It changes my pace, not my direction.</p>
        <p class="body ms__keep">If you’ve just been diagnosed and you’re reading this: keep building.</p>
        <a
          class="text-link"
          href="https://www.mssociety.org.uk/about-ms/types-of-ms/relapsing-remitting-ms"
          rel="noopener"
        >
          What is RRMS? <Icon name="external" size={16} />
        </a>
      </div>
    </section>

    <!-- Coming soon -->
    <section class="grey soon" id="soon" aria-labelledby="soon-title">
      <div class="container">
        <div class="soon__head">
          <h2 class="headline" id="soon-title">Coming soon.</h2>
          <p class="lead soon__lead">
            A public bot is on the way. It gets its own Discord server when it launches, and its code goes on GitHub.
          </p>
        </div>
        <ul class="soon__list">
          {
            soon.map((item) => (
              <li class="soon__item">
                <p class="soon__name">{item.title}</p>
                <p class="soon__text">{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <footer class="grey footer">
    <div class="container footer__inner">
      <p class="fine">
        Photos from Pixabay by <a href={credit['lando-silverstone'].userURL}>{credit['lando-silverstone'].user}</a>{' '}
        and <a href={credit.rain.userURL}>{credit.rain.user}</a>. McLaren speedmark by{' '}
        <a href="https://icons8.com">icons8</a>. Lap positions from the <a href="https://api.jolpi.ca/">Jolpica F1 API</a>.
      </p>
      <p class="fine">© 2026 Anthony.</p>
    </div>
  </footer>
</Base>

<style>
  /* About statement */
  .about {
    padding-block: var(--section-y);
  }

  /* Insko Bot: copy on the left, the icon large on the right, crossing up into the white section above. */
  .insko {
    position: relative;
    padding-block: var(--section-y);
  }

  .insko__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: start;
    gap: var(--s8);
  }

  .insko__text {
    display: grid;
    justify-items: start;
    gap: var(--s3);
  }

  .insko__lead {
    max-width: 26ch;
    color: var(--on-dark-2);
  }

  .insko .actions {
    justify-content: flex-start;
    margin-top: var(--s1);
  }

  .insko__next {
    margin-top: var(--s4);
    color: var(--on-dark-2);
    font-size: 0.9375rem;
  }

  .insko__next a {
    color: var(--on-dark);
  }

  .insko :global(.insko__icon) {
    --icon: clamp(11rem, 24vw, 18rem);
    position: relative;
    z-index: 1;
    justify-self: end;
    width: var(--icon);
    height: var(--icon);
    margin-top: calc(-1 * var(--section-y) - var(--icon) * 0.45);
    border-radius: 22.5%;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.14);
  }

  /* Formula 1: the copy holds the left column; the photo bleeds off the right edge of the screen. */
  .f1 {
    padding-top: var(--section-y);
    /* clip, not hidden: the drive-in may not widen the page, and the pinned trace inside must stay sticky. */
    overflow-x: clip;
  }

  .f1__stage {
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--gutter), 1fr)
      [text-start] minmax(0, 24rem)
      [text-end] var(--s8)
      [photo-start] minmax(0, calc(var(--container) - 24rem - var(--s8)))
      minmax(var(--gutter), 1fr) [full-end];
    grid-template-rows: auto 1fr auto;
  }

  .f1__head {
    grid-column: text;
    grid-row: 1;
    display: grid;
    gap: var(--s3);
  }

  .f1__lead {
    color: var(--on-dark-2);
  }

  .f1__photo {
    grid-column: photo-start / full-end;
    grid-row: 1 / 4;
    margin-top: var(--s12);
  }

  .f1__frame {
    overflow: hidden;
    border-radius: var(--radius) 0 0 var(--radius);
  }

  .f1__frame :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 46% 62%;
  }

  .f1__caption {
    margin-top: var(--s2);
    color: #86868b;
    font-size: 0.8125rem;
  }

  .f1__pick {
    grid-column: text;
    grid-row: 3;
    align-self: end;
    margin-bottom: var(--s6);
  }

  .f1__caption a,
  .rain a,
  .footer a {
    color: inherit;
  }

  /* The car drives in: the frame slides left while it unclips from the right. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .f1__frame {
        animation-name: drive-in;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 10% cover 45%;
      }
    }
  }

  @keyframes drive-in {
    from {
      translate: 14% 0;
      clip-path: inset(0 0 0 35% round var(--radius) 0 0 var(--radius));
    }
    to {
      translate: 0 0;
      clip-path: inset(0 0 0 0 round var(--radius) 0 0 var(--radius));
    }
  }

  /* The rain: a tall panel bleeding off the left edge, the copy on the right. */
  .rain {
    padding-block: var(--section-y);
    overflow: hidden;
  }

  .rain__stage {
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--gutter), 1fr)
      [panel-end-inner] minmax(0, calc(var(--container) - 26rem - var(--s8)))
      [panel-end] var(--s8)
      [text-start] minmax(0, 26rem)
      [text-end] minmax(var(--gutter), 1fr) [full-end];
    align-items: center;
  }

  .rain__panel {
    grid-column: full-start / panel-end;
    grid-row: 1;
    height: min(42rem, 78vh);
    overflow: hidden;
    border-radius: 0 var(--radius) var(--radius) 0;
    background: #d9dcdc;
  }

  .rain__panel :global(picture) {
    display: block;
    height: 100%;
  }

  .rain__panel :global(img) {
    width: 100%;
    height: 118%;
    object-fit: cover;
  }

  .rain__text {
    grid-column: text;
    grid-row: 1;
    display: grid;
    gap: var(--s3);
  }

  .rain__text .fine {
    margin-top: var(--s2);
  }

  /* The drops drift downward as you scroll, as if still falling. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .rain__panel :global(img) {
        animation-name: fall;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }
    }
  }

  @keyframes fall {
    from {
      translate: 0 -15%;
    }
    to {
      translate: 0 0;
    }
  }

  /* Worst day: the quote on the left, the speedmark sweeping in large on the right. */
  .worst {
    padding-block: var(--section-y);
    overflow: hidden;
  }

  .worst__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s2) var(--s8);
  }

  .worst__quote p {
    max-width: 16ch;
    font-size: clamp(2.25rem, 5.4vw, 4rem);
    font-weight: 650;
    line-height: 1.06;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .worst :global(.worst__mark) {
    grid-column: 2;
    grid-row: 1 / 3;
    width: clamp(8rem, 18vw, 14rem);
    height: auto;
  }

  .worst__sign {
    grid-column: 1;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  @media (max-width: 48rem) {
    .insko__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s4);
    }

    .insko :global(.insko__icon) {
      --icon: 9rem;
      order: -1;
    }

    .f1__stage {
      grid-template-columns:
        [full-start] var(--gutter)
        [text-start photo-start] minmax(0, 1fr)
        [text-end] var(--gutter) [full-end];
      grid-template-rows: auto;
    }

    .f1__photo {
      grid-row: 2;
      margin-top: var(--s8);
    }

    .f1__pick {
      grid-row: 3;
      margin: var(--s8) 0 0;
    }

    .rain__stage {
      grid-template-columns:
        [full-start] var(--gutter)
        [text-start] minmax(0, 1fr)
        [panel-end text-end] var(--gutter) [full-end];
    }

    .rain__panel {
      grid-column: full-start / panel-end;
      height: auto;
      aspect-ratio: 4 / 3;
      margin-bottom: var(--s6);
    }

    .rain__text {
      grid-row: 2;
    }

    .worst__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .worst :global(.worst__mark) {
      grid-column: 1;
      grid-row: auto;
      justify-self: end;
      order: -1;
      width: 7rem;
    }
  }

  /* MS */
  .ms {
    padding-block: var(--section-y);
  }

  .ms__inner {
    display: grid;
    justify-items: center;
    gap: var(--s3);
    text-align: center;
  }

  .ms__lead {
    max-width: 32ch;
    color: var(--ink-2);
  }

  .ms__keep {
    margin-top: var(--s4);
    font-weight: 560;
  }

  .ms .text-link {
    margin-top: calc(var(--s1) * -1);
  }

  /* Coming soon */
  .soon {
    padding-block: var(--section-y) var(--s16);
  }

  .soon__head {
    display: grid;
    justify-items: center;
    gap: var(--s3);
    text-align: center;
  }

  .soon__lead {
    max-width: 34ch;
    color: var(--ink-2);
  }

  .soon__list {
    max-width: 48rem;
    margin: var(--s12) auto 0;
    border-top: 1px solid var(--hair);
  }

  .soon__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    align-items: baseline;
    gap: var(--s1) var(--s4);
    padding-block: var(--s3);
    border-bottom: 1px solid var(--hair);
  }

  .soon__name {
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    font-weight: 650;
    letter-spacing: -0.025em;
  }

  .soon__text {
    color: var(--ink-2);
    font-size: 1.0625rem;
  }

  @media (max-width: 36rem) {
    .soon__item {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Footer */
  .footer {
    border-top: 1px solid var(--hair);
  }

  .footer__inner {
    display: grid;
    gap: var(--s1);
    padding-block: var(--s4) var(--s6);
  }

  .footer .fine {
    max-width: 80ch;
  }
</style>
